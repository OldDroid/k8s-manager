<?xml version="1.0" encoding="UTF-8"?>
<server description="k8s-manager">

    <featureManager>
        <feature>restfulWS-3.1</feature>
        <feature>jsonb-3.0</feature>
    </featureManager>

    <!-- host="*" binds 0.0.0.0; TLS is terminated by the Route/Ingress, so no HTTPS listener. -->
    <httpEndpoint id="defaultHttpEndpoint" host="*" httpPort="9080" httpsPort="-1"/>

    <webApplication location="k8s-manager.war" contextRoot="/"/>

    <logging consoleFormat="simple" consoleLogLevel="INFO" messageFormat="simple"/>

</server>
